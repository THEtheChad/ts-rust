diff --git a/tsc/internal/vfs/osvfs/obs.go b/tsc/internal/vfs/osvfs/obs.go
new file mode 100644
index 0000000..137e021
--- /dev/null
+++ b/tsc/internal/vfs/osvfs/obs.go
@@ -0,0 +1,97 @@
+package osvfs
+
+// SPIKE (ts-rust L1 window measurement, never merged): every OS call of the
+// OS file system with the time before it, written to GOPORT_LOAD_OBS_LOG after
+// the watch registration that follows (Session.updateWatches), in the format
+// of ts-rust's base spike (scripts/perf-rearch/loader/l1-window.py `base`):
+// `load <t0> <t1>` per program load, `os <kind> <ms> loader <path>` per call
+// (every goroutine: Go has no loader thread), `watch <ms> <registrations>`.
+
+import (
+	"fmt"
+	"os"
+	"strings"
+	"sync"
+	"time"
+)
+
+var (
+	obsStart = time.Now()
+	obsFile  = func() *os.File {
+		name := os.Getenv("GOPORT_LOAD_OBS_LOG")
+		if name == "" {
+			return nil
+		}
+		f, err := os.OpenFile(name, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)
+		if err != nil {
+			return nil
+		}
+		return f
+	}()
+	obsMu    sync.Mutex
+	obsCalls []obsCall
+	obsLoads [][2]int64
+	obsRegs  []string
+)
+
+// ObsRegistered counts a watch registration the client answered
+// (client.WatchFiles in Session.updateWatch) for the next ObsWatch.
+func ObsRegistered(id string) {
+	if obsFile == nil {
+		return
+	}
+	obsMu.Lock()
+	obsRegs = append(obsRegs, strings.ReplaceAll(id, " ", "_"))
+	obsMu.Unlock()
+}
+
+type obsCall struct {
+	ns   int64
+	kind string
+	path string
+}
+
+// ObsClockNs is the observation clock (monotonic ns since the start).
+func ObsClockNs() int64 { return int64(time.Since(obsStart)) }
+
+func obsOS(kind string, path string) {
+	if obsFile == nil {
+		return
+	}
+	ns := ObsClockNs()
+	obsMu.Lock()
+	obsCalls = append(obsCalls, obsCall{ns, kind, path})
+	obsMu.Unlock()
+}
+
+// ObsLoad keeps the span of a program load for the next ObsWatch.
+func ObsLoad(t0, t1 int64) {
+	if obsFile == nil {
+		return
+	}
+	obsMu.Lock()
+	obsLoads = append(obsLoads, [2]int64{t0, t1})
+	obsMu.Unlock()
+}
+
+// ObsWatch: the watch registration ended. Writes the loads and calls kept
+// since the last one, then `watch <ms> <registrations answered> <their ids>`.
+func ObsWatch() {
+	if obsFile == nil {
+		return
+	}
+	at := ObsClockNs()
+	obsMu.Lock()
+	loads, calls, regs := obsLoads, obsCalls, obsRegs
+	obsLoads, obsCalls, obsRegs = nil, nil, nil
+	obsMu.Unlock()
+	var b strings.Builder
+	for _, l := range loads {
+		fmt.Fprintf(&b, "load %.3f %.3f\n", float64(l[0])/1e6, float64(l[1])/1e6)
+	}
+	for _, c := range calls {
+		fmt.Fprintf(&b, "os %s %.3f loader %s\n", c.kind, float64(c.ns)/1e6, c.path)
+	}
+	fmt.Fprintf(&b, "watch %.3f %d %s\n", float64(at)/1e6, len(regs), strings.Join(regs, ","))
+	_, _ = obsFile.WriteString(b.String())
+}
