+// SPIKE (L1 round 3 window measurement, never merged): every OS call with
+// its time on the observation log (`GOPORT_LOAD_OBS_LOG`).
+pub fn obs_clock_ns() -> u64 {
+    static START: OnceLock<std::time::Instant> = OnceLock::new();
+    START.get_or_init(std::time::Instant::now).elapsed().as_nanos() as u64
+}
+
+pub fn obs_line(line: std::fmt::Arguments<'_>) {
+    obs_write(line, true);
+}
+
+fn obs_write(line: std::fmt::Arguments<'_>, flush: bool) {
+    use std::io::Write;
+    static LOG: OnceLock<Option<std::sync::Mutex<std::io::BufWriter<std::fs::File>>>> = OnceLock::new();
+    let log = LOG.get_or_init(|| {
+        let file = std::env::var("GOPORT_LOAD_OBS_LOG").ok()?;
+        std::fs::OpenOptions::new().create(true).append(true).open(file).ok()
+            .map(|f| std::sync::Mutex::new(std::io::BufWriter::new(f)))
+    });
+    if let Some(log) = log {
+        let mut log = log.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        let _ = log.write_fmt(line);
+        let _ = log.write_all(b"\n");
+        if flush {
+            let _ = log.flush();
+        }
+    }
+}
+
+thread_local! {
+    /// The loading thread's OS calls of the load in progress (`obs_begin`).
+    static OBS_BUF: std::cell::RefCell<Option<Vec<(u64, &'static str, String)>>> = const { std::cell::RefCell::new(None) };
+}
+
+/// Starts recording this thread's OS calls (the load on it).
+pub fn obs_begin() {
+    OBS_BUF.with(|b| *b.borrow_mut() = Some(Vec::with_capacity(65536)));
+}
+
+/// Ends the recording and writes it to the log.
+pub fn obs_end() {
+    use std::fmt::Write as _;
+    let Some(calls) = OBS_BUF.with(|b| b.borrow_mut().take()) else { return };
+    let mut text = String::new();
+    for (ns, kind, path) in calls {
+        let _ = writeln!(text, "os {kind} {:.3} loader {path}", ns as f64 / 1e6);
+    }
+    obs_line(format_args!("{}", text.trim_end()));
+}
+
+fn obs_os(kind: &'static str, path: &str) {
+    OBS_BUF.with(|b| {
+        if let Some(calls) = b.borrow_mut().as_mut() {
+            calls.push((obs_clock_ns(), kind, path.to_string()));
+        }
+    });
+}
