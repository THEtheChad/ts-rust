#!/bin/bash
# Lane ND2 probe: an npm that waits ND2_NPM_DELAY seconds (default 0; "rand:<max>" waits a uniform
# random time up to <max> seconds, a new one per call), then runs the real npm (the
# next npm on PATH after this dir), and appends "<start> <end> <rc> <args>" (epoch seconds) to
# ND2_NPM_TIMES when set. First on a language server's PATH, a delay makes ATA's npm calls slower than
# the scenario's checkpoints: the watch-ts-pattern-f12 load race on demand.
self=$(cd "$(dirname -- "$0")" && pwd)
t0=$(date +%s.%N)
delay=${ND2_NPM_DELAY:-0}
case $delay in rand:*) delay=$(awk -v m="${delay#rand:}" -v s="$$$(date +%N)" 'BEGIN { srand(s); printf "%.3f", rand() * m }') ;; esac
sleep "$delay"
PATH=$(printf %s "$PATH" | tr : '\n' | grep -vx "$self" | paste -sd:)
npm "$@"; rc=$?
[ -n "${ND2_NPM_TIMES:-}" ] && echo "$t0 $(date +%s.%N) $rc delay=$delay $*" >> "$ND2_NPM_TIMES"
exit $rc
