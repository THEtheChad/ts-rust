#!/bin/sh
# The stand-in npm of every watch scenario with ATA on (scenario.mjs): first on the language server's
# PATH, so ATA's npm calls run fake-npm.mjs with the node the sandbox binds at a fixed path (lane H8
# round 2: nothing of the environment, which the server controls).
# Nothing of the server's environment reaches node (lane H8 round 3: NODE_OPTIONS, NODE_PATH and the like
# would run other code): an empty environment, node and the stand-in at their fixed paths, no flags.
exec /usr/bin/env -i /run/lspdiff-ata/node /run/lspdiff-ata/fake-npm.mjs "$@"
